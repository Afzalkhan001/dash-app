# DASH mobile — environment variables (template, safe to commit).
#
# There are NO secret keys in this app. Every EXPO_PUBLIC_* value is written into the app at build
# time and anyone who installs the app can read it, so never put a password, token or API key here.
#
# For EAS builds, set these on expo.dev → project "dash" (account afzalkhan8326) → Environment variables (see docs/EXPO-ENV.md).
# For local dev, copy this file to .env.local (git-ignored) and change what you need.

# DASH server address. Optional: without it the app uses https://dash.tamadamedia.in.
# Local server example: http://192.168.1.20:3000
EXPO_PUBLIC_DASH_URL=https://dash.tamadamedia.in

# Demo account in internal preview builds: set to 1 on expo.dev in the "preview" environment ONLY.
# Never create it in "production". Not needed locally: Expo Go and dev builds always have the demo.
# It only works together with EXPO_PUBLIC_BUILD_PROFILE=preview, which eas.json sets per build profile
# (do not set EXPO_PUBLIC_BUILD_PROFILE yourself).
# EXPO_PUBLIC_DEMO=1
