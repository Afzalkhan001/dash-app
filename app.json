{
  "expo": {
    "name": "DASH",
    "slug": "dash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "dashmobile",
      "com.tamadamedia.dashmobile"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "com.tamadamedia.dashmobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#472E22",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tamadamedia.dashmobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFBF9",
          "image": "./assets/images/brand-logo-stacked.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow DASH to use Face ID to unlock the app."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DASH uses your location to clock you in and out at the office."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DASH needs your photos to attach bills, receipts and documents.",
          "cameraPermission": "DASH uses the camera to capture bills, receipts and documents."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow DASH to use Face ID to unlock the app."
        }
      ],
      "expo-sharing",
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#C33B02"
              },
              "textColorPrimary": {
                "light": "#1E1A17"
              }
            },
            "timePicker": {
              "headerBackground": {
                "light": "#C33B02"
              },
              "numbersSelectorColor": {
                "light": "#C33B02"
              },
              "numbersBackgroundColor": {
                "light": "#FDEDE5"
              }
            }
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "DASH uses the camera to scan visitor passes and asset tags, and to capture bills and documents.",
          "microphonePermission": "DASH uses the microphone to record voice notes and for calls.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "DASH uses the microphone to record voice notes and for calls.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C33B02",
          "defaultChannel": "default"
        }
      ],
      "expo-asset",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e93a7904-efb7-412a-aba1-d868194e1128"
      }
    },
    "owner": "afzalkhan8326"
  }
}
